body {
  margin: 0;
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  background-color: #1e1e2f;
  color: white;
  font-family: Arial, sans-serif;
}

#mazeCanvas {
  background-color: white;
  border: 5px solid #444;
  border-radius: 10px;

  box-shadow: 0 0 25px rgba(0, 0, 0, 0.5);
}

#winMessage {
  margin-top: 20px;
  font-size: 28px;
  font-weight: bold;
  color: #4ade80;
}

